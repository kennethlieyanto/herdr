#!/usr/bin/env bash
set -euo pipefail

project_directories=(
  ~/projects/work
  ~/projects/personal
  ~/projects/github
  ~/projects/godot
  ~/projects/playground
  ~/dotfiles
)

other_directories=(
  ~/.local/share/chezmoi
  ~/Vaults/notes
  ~/Vaults/sp-notes
  ~/nix-config
)

if [[ $# -eq 1 ]]; then
  selected=$1
else
  find_dirs=()
  for dir in "${project_directories[@]}"; do
    expanded_dir=$(eval echo "$dir")
    [[ -d $expanded_dir ]] && find_dirs+=("$expanded_dir")
  done

  if [[ ${#find_dirs[@]} -gt 0 ]]; then
    project_results=$(find "${find_dirs[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
  else
    project_results=""
  fi

  for dir in "${other_directories[@]}"; do
    expanded_dir=$(eval echo "$dir")
    project_results+=$'\n'"$expanded_dir"
  done

  selected=$(echo -e "$project_results" | fzf)
fi

[[ -z ${selected:-} ]] && exit 0

selected_name=$(basename "$selected" | tr . _)

# Ensure the single default herdr session/server is running
if ! herdr workspace list &>/dev/null; then
  herdr server &>/dev/null &
  for _ in {1..20}; do
    herdr workspace list &>/dev/null && break
    sleep 0.5
  done
fi

# Reuse an existing workspace (matched by label, like tmux session name)
ws_id=$(herdr workspace list 2>/dev/null \
  | jq -r --arg name "$selected_name" \
      '(.result.workspaces // .workspaces // [])[] | select(.label == $name) | .workspace_id' \
  | head -n1)

if [[ -n $ws_id ]]; then
  herdr workspace focus "$ws_id" >/dev/null
else
  herdr workspace create --cwd "$selected" --label "$selected_name" --focus >/dev/null
fi

# Already inside herdr: focus above switched the UI. Otherwise attach.
if [[ "${HERDR_ENV:-}" != 1 ]]; then
  exec herdr
fi
